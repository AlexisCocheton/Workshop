# --- Secrets (jamais en clair) ---
.env
*.env
!.env.example
cyber/secrets/key.txt
*.key
*.pem

# --- Override local de démonstration (ports spécifiques à une machine) ---
compose.override.yml

# --- Données et modèles entraînés (régénérés par /retrain-model) ---
ai/data/*.csv
ai/data/*.joblib
# anciennes collectes archivées localement
ai/data/archive/
# on garde ai/data/report.json comme preuve de résultats
!ai/data/report.json
# Visages enregistrés : donnée biométrique (RGPD art. 9), jamais versionnée
ai/data/face_encodings/

# --- Python ---
**/.venv/
**/__pycache__/
**/*.pyc
**/.pytest_cache/

# --- IoT (ESP8266, PlatformIO + CLion) ---
iot/include/secrets.h
iot/.pio/
iot/.idea/
iot/cmake-build-*/
iot/CMakeListsPrivate.txt

# --- Node ---
dev/frontend/node_modules/
dev/frontend/dist/

# --- Énoncés du sujet (fournis, non livrables) ---
*.pdf
*.pptx

# --- Divers ---
.DS_Store
# Photos de travail (consignes prises en photo, matériel) : non versionnées
*.jpg
*.jpeg
*.png
# sauf les images utiles au dépôt (schémas, captures de doc) à ajouter explicitement
!**/docs/**/*.png
# photos des produits de la boutique (libres de droits, voir dev/shop/src/credits.js)
!dev/shop/public/products/*.jpg

# Dossier : on versionne le .md source, pas le rendu
Dossier.html
Dossier.pdf

# --- Node (dashboard, boutique) ---
**/node_modules/
**/dist/
