# Copier ce fichier en .env et remplacer TOUTES les valeurs par des secrets forts.
# Le .env n'est JAMAIS versionné en clair (voir cyber/secrets/ pour SOPS).
# Astuce : générer un secret avec  openssl rand -hex 32

# Base de données de paiement
POSTGRES_DB=payments
POSTGRES_USER=app
POSTGRES_PASSWORD=REMPLACER-par-un-mot-de-passe-fort

# Authentification (secret partagé auth <-> api, obligatoire)
JWT_SECRET=REMPLACER-par-un-secret-aleatoire-32-octets
# Compte de DÉMONSTRATION, volontairement public : utilisé par le bouton du
# dashboard (dev/frontend/src/api.js) et par le simulateur de trafic (ai/traffic.py).
# Il ne peut que créer des transactions fictives. Garder les mêmes valeurs partout.
DEMO_USER=app
DEMO_PASSWORD=app

# Back-office (dashboard) : identifiant, reconnaissance faciale, puis ce mot de passe.
# Mot de passe vide = back-office fermé (les paiements fonctionnent quand même).
BACKOFFICE_USER=admin
BACKOFFICE_PASSWORD=REMPLACER-par-un-mot-de-passe-fort
# Compte de test qui saute la caméra (même mot de passe). Vide = désactivé. Jamais en démo.
BACKOFFICE_TEST_USER=

# Boutique : compte marchand (réapprovisionne le stock, ajoute des confiseries).
# Créé au démarrage de l'api ; mot de passe de 8 caractères minimum. Vide = pas de marchand.
SHOP_MERCHANT_EMAIL=marchand@alpha-prime.test
SHOP_MERCHANT_PASSWORD=REMPLACER-par-un-mot-de-passe-fort

# Moteur de remédiation (jeton partagé avec le détecteur IA, obligatoire)
REMEDIATION_TOKEN=REMPLACER-par-un-jeton-aleatoire
REMEDIATION_URL=http://remediation:8200/incident

# Dashboard : origines autorisées pour les appels navigateur (CORS).
# Ouvrir le dashboard via http://127.0.0.1:3000 sur le PC Hôte (voir README).
DASHBOARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Boutique : ajouter http://<IP du PC Hôte>:3002 pour l'ouvrir depuis un autre PC du réseau.
SHOP_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# Assistant IA (modèle local, 8 milliards de paramètres maximum)
OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_URL=http://192.168.137.2:11434   # décommenter si Ollama tourne sur le PC de délestage IA

# Grafana (obligatoire)
GRAFANA_PASSWORD=REMPLACER-par-un-mot-de-passe-fort
