# Copier ce fichier en .env et remplacer TOUTES les valeurs par des secrets forts.
# Le .env n'est JAMAIS versionné en clair (voir cyber/secrets/ pour SOPS).
# Astuce : générer un secret avec  openssl rand -hex 32

# Base de données de paiement
POSTGRES_DB=payments
POSTGRES_USER=app
POSTGRES_PASSWORD=REMPLACER-par-un-mot-de-passe-fort

# Authentification (secret partagé auth <-> api, obligatoire)
JWT_SECRET=REMPLACER-par-un-secret-aleatoire-32-octets
# Compte de DÉMONSTRATION, volontairement public : utilisé par le bouton du
# dashboard (dev/frontend/src/App.jsx) et par le simulateur de trafic (ai/traffic.py).
# Il ne peut que créer des transactions fictives. Garder les mêmes valeurs partout.
DEMO_USER=app
DEMO_PASSWORD=app

# Moteur de remédiation (jeton partagé avec le détecteur IA, obligatoire)
REMEDIATION_TOKEN=REMPLACER-par-un-jeton-aleatoire
REMEDIATION_URL=http://remediation:8200/incident

# Dashboard : origines autorisées pour les appels navigateur (CORS)
DASHBOARD_ORIGINS=http://localhost:3000

# Assistant IA (modèle local, 8 milliards de paramètres maximum)
OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_URL=http://192.168.137.2:11434   # décommenter si Ollama tourne sur le PC de délestage IA

# Grafana (obligatoire)
GRAFANA_PASSWORD=REMPLACER-par-un-mot-de-passe-fort
