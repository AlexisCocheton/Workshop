# Copier ce fichier en .env et remplacer les valeurs. Le .env n'est JAMAIS
# versionné en clair (voir cyber/secrets/ pour le chiffrement SOPS).

# Base de données de paiement
POSTGRES_DB=payments
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# Authentification
JWT_SECRET=change-me
DEMO_USER=app
DEMO_PASSWORD=app

# Moteur de remédiation (jeton partagé avec le détecteur IA)
REMEDIATION_TOKEN=change-me
REMEDIATION_URL=http://remediation:8200/incident

# Assistant IA (modèle local, 8 milliards de paramètres maximum)
OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_URL=http://192.168.137.2:11434   # décommenter si Ollama tourne sur le PC de délestage IA

# Grafana
GRAFANA_PASSWORD=admin
